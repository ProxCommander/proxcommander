// Static-only deploy of the web build to Cloudflare Workers (no Worker script).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "proxcommander",
  "compatibility_date": "2026-11-09",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [{ "pattern": "proxcommander.app", "custom_domain": true }],
  // Required by `wrangler preview` (non-production branch builds); may stay empty.
  "previews": {}
}
